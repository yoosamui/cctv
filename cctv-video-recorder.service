[Unit]
Description=CCTV Recording Service
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/cctv
# The -u flag forces immediate logging
ExecStart=/usr/bin/python3 -u /home/pi/cctv/cctv-video-recorder.py
Restart=always
RestartSec=5
# This ensures logs go to the right place
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


